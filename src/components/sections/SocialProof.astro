---
const stats = [
  { value: "12k+", label: "Replay sessions run" },
  { value: "4.8/5", label: "Average trader rating" },
  { value: "30+", label: "FX pairs supported" },
];
---

<section aria-label="Trusted by traders" class="border-y border-border-primary bg-bg-secondary">
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 px-6 py-14 sm:grid-cols-3">
    {
      stats.map((stat) => (
        <div class="text-center">
          <p class="text-3xl font-black text-text-brand">{stat.value}</p>
          <p class="mt-2 text-sm text-text-secondary">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>
