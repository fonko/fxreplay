---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const { heroVariant } = Astro.locals;
const isTest = heroVariant === "test";
---

<section id="hero" class="relative overflow-hidden px-6 py-20 text-center sm:py-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-1/2 h-[560px] w-[900px] -translate-x-1/2 -translate-y-1/3 rounded-full bg-border-brand/25 blur-[120px]"
  />

  <div class="relative mx-auto max-w-5xl">
    {
      isTest ? (
        <>
          <h1 class="bg-gradient-to-b from-text-primary to-text-disabled bg-clip-text text-4xl font-black tracking-tight text-transparent sm:text-6xl">
            Trade Smarter. Backtest Instantly.
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-lg text-text-secondary">
            Replay any market, any timeframe, at your own pace — and turn hindsight into your edge.
          </p>
        </>
      ) : (
        <>
          <h1 class="bg-gradient-to-b from-text-primary to-text-disabled bg-clip-text text-4xl font-black tracking-tight text-transparent sm:text-6xl">
            Try FX Replay Free
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-lg text-text-secondary">
            The fastest way to backtest and sharpen your trading strategy with realistic market
            replay.
          </p>
        </>
      )
    }

    <div class="mt-10 flex justify-center">
      <a
        href="#signup"
        data-cta-location="hero"
        data-cta-text="Try FX Replay Free"
        data-cta-variant={heroVariant}
        class={cn(
          buttonVariants({ size: "lg" }),
          "bg-btn-bg-primary-active text-btn-text hover:bg-btn-bg-primary-hover",
        )}
      >
        Try FX Replay Free
      </a>
    </div>
  </div>
</section>
