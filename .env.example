PUBLIC_POSTHOG_KEY=phc_xxx
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional: enables local feature-flag evaluation server-side (no network
# round trip per SSR request), and (with the two vars below) the admin
# panel's per-user PostHog timeline. Create one in PostHog under Project
# Settings, with the "Query Read" permission for the timeline to work.
POSTHOG_PERSONAL_API_KEY=phx_xxx
# The Query API lives on the *app* host, not the ingestion host above —
# us.posthog.com or eu.posthog.com depending on your PostHog Cloud region.
POSTHOG_APP_HOST=https://us.posthog.com
# Settings > Project > Project ID in the PostHog UI.
POSTHOG_PROJECT_ID=

DATABASE_URL=postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Server-only — never import in client-hydrated components.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

PUBLIC_SITE_URL=https://fxreplay.alfonsopayra.me

# Shared secret gating the Users API's update/list actions (no end-user auth
# exists for this challenge). Generate with `openssl rand -hex 32`.
ADMIN_API_KEY=

# SMTP mailbox used to send magic-link confirmation emails after signup.
SMTP_HOST=smtp.dreamhost.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset.
EMAIL_FROM=
